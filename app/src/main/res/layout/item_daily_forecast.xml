<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <!-- DAY -->

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:text="Tuesday"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- WEATHER ICON -->

    <ImageView
        android:id="@+id/ivDayIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:src="@android:drawable/ic_menu_day"
        android:contentDescription="Daily weather icon" />

    <!-- CONDITION -->

    <TextView
        android:id="@+id/tvDayCondition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="Sunny"
        android:textColor="#E8F5FF"
        android:textSize="13sp" />

    <!-- HIGH TEMPERATURE -->

    <TextView
        android:id="@+id/tvDayMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="31°"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- LOW TEMPERATURE -->

    <TextView
        android:id="@+id/tvDayMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="24°"
        android:textColor="#DDEEFF"
        android:textSize="15sp" />

</LinearLayout>
